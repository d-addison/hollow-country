FrameWidgetClass HCRecipeHelpRoot {
 position 0 0 size 1 1
 hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
 ignorepointer 1 priority 200
 {
  PanelWidgetClass HCRecipeHelpPanel {
   position 0.05 0.15 size 0.90 0.70
   hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
   visible 0 clipchildren 1
   style rover_sim_colorable color 0.025 0.025 0.025 1
   {
    TextWidgetClass HCRecipeHelpTitle {
     position 0.025 0.03 size 0.95 0.09
     hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
     ignorepointer 1 text "Hollow Country: recipes and actions"
     font "gui/fonts/sdf_MetronBook24" "text color" 1 1 1 1
    }
    TextListboxWidgetClass HCRecipeTopics {
     position 0.025 0.17 size 0.34 0.77
     hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
     font "gui/fonts/sdf_MetronBook24"
    }
    RichTextWidgetClass HCRecipeDetail {
     position 0.40 0.17 size 0.57 0.77
     hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
     ignorepointer 1 font "gui/fonts/sdf_MetronBook24" "text color" 1 1 1 1
    }
   }
  }
  ButtonWidgetClass HCRecipeHelpToggle {
   position 0.70 0.075 size 0.25 0.055
   hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
   text "Hollow Country help" font "gui/fonts/sdf_MetronBook24"
  }
 }
}
