 PanelWidgetClass HCAdminCard {
  position 0 0 size 1 158
  hexactpos 0 vexactpos 1 hexactsize 0 vexactsize 1
  style rover_sim_black color 0.08 0.095 0.115 1
  {
   TextWidgetClass HCAdminCardLabel {
    position 0.02 10 size 0.66 26
    hexactpos 0 vexactpos 1 hexactsize 0 vexactsize 1
    ignorepointer 1 font "gui/fonts/sdf_MetronBook24" "exact text" 1  text "" "exact text size" 20
   }
   TextWidgetClass HCAdminCardTag {
    position 0.69 10 size 0.29 26
    hexactpos 0 vexactpos 1 hexactsize 0 vexactsize 1
    ignorepointer 1 font "gui/fonts/sdf_MetronBook24" "exact text" 1  text "" "exact text size" 13 "text halign" right
   }
   MultilineTextWidgetClass HCAdminCardHelp {
    position 0.02 42 size 0.96 42
    hexactpos 0 vexactpos 1 hexactsize 0 vexactsize 1
    ignorepointer 1 font "gui/fonts/sdf_MetronBook24" "exact text" 1  text "" wrap 1 "size to text v" 1 "exact text size" 15
   }
   FrameWidgetClass HCAdminValueControls {
    position 0 92 size 0.80 32
    hexactpos 0 vexactpos 1 hexactsize 0 vexactsize 1
    {
     ButtonWidgetClass HCAdminMinus {
      position 0.02 0 size 0.07 32
      hexactpos 0 vexactpos 1 hexactsize 0 vexactsize 1
      style Default font "gui/fonts/sdf_MetronBook24" text "-" text_proportion 0.55
     }
     EditBoxWidgetClass HCAdminValue {
      position 0.10 0 size 0.12 32
      hexactpos 0 vexactpos 1 hexactsize 0 vexactsize 1
      font "gui/fonts/sdf_MetronBook24" text "1"
     }
     ButtonWidgetClass HCAdminPlus {
      position 0.23 0 size 0.07 32
      hexactpos 0 vexactpos 1 hexactsize 0 vexactsize 1
      style Default font "gui/fonts/sdf_MetronBook24" text "+" text_proportion 0.55
     }
     TextWidgetClass HCAdminRange {
      position 0.33 0 size 0.45 32
      hexactpos 0 vexactpos 1 hexactsize 0 vexactsize 1
      ignorepointer 1 font "gui/fonts/sdf_MetronBook24" "exact text" 1  text "" "text valign" center "exact text size" 14
     }
    }
   }
   ButtonWidgetClass HCAdminRun {
    position 0.82 92 size 0.16 32
    hexactpos 0 vexactpos 1 hexactsize 0 vexactsize 1
    style Default font "gui/fonts/sdf_MetronBook24" text "Run" text_proportion 0.55
   }
   TextWidgetClass HCAdminPosition {
    position 0.02 132 size 0.96 20
    hexactpos 0 vexactpos 1 hexactsize 0 vexactsize 1
    ignorepointer 1 font "gui/fonts/sdf_MetronBook24" "exact text" 1  text "" "exact text size" 13 color 0.65 0.72 0.79 1
   }
  }
 }
