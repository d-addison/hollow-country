     text "14" font "gui/fonts/sdf_MetronBook24"
    }
    ButtonWidgetClass HCAdminDay {
     position 0.74 0.525 size 0.23 0.045
     hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
