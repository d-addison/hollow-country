    }
    TextListboxWidgetClass HCAdminStatusRows {
     position 0.03 0.59 size 0.94 0.33
     hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
     font "gui/fonts/sdf_MetronBook24"
    }
    ButtonWidgetClass HCAdminClose {
     position 0.03 0.94 size 0.94 0.04
     hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
     text "Close" style Default
    }
   }
  }
  PanelWidgetClass HCAdminNoticePanel {
   position 0 0.88 size 0.65 0.12
   hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
   style rover_sim_black color 0.04 0.04 0.04 0.98
   {
    MultilineTextWidgetClass HCAdminNotice {
     position 0.02 0.05 size 0.96 0.90
     hexactpos 0 vexactpos 0 hexactsize 0 vexactsize 0
     ignorepointer 1 font "gui/fonts/sdf_MetronBook24"
     text "Request a snapshot to see registered debug layers. No snapshot polling."
    }
   }
  }
 }
