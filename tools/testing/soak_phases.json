 "phases": [
  {
   "name": "join",
   "minutes": 5,
   "what": "spawn wait, stand, sprint, map/inventory/pause menus and the admin status command"
  },
  {
   "name": "group",
   "minutes": 2,
   "what": "create a solo group and send a team ping"
  },
  {
   "name": "walk_ai",
   "minutes": 30,
   "what": "walk to the nearest AI site on foot (no teleport)"
  },
  {
   "name": "walk_zone",
   "minutes": 45,
   "what": "walk into a zone with guards and an event radius"
  },
  {
   "name": "walk_town",
   "minutes": 20,
   "what": "walk through a town for signs of life, interiors and doors"
  },
  {
   "name": "fixtures",
   "minutes": 10,
   "what": "setup-only admin fixtures at the spot; the real feature code then runs normally"
  },
  {
   "name": "actions",
   "minutes": 15,
   "what": "real vanilla and HC actions through the client action manager"
  },
  {
   "name": "idle",
   "minutes": 125,
   "what": "stand still; background and time-window counters; DebugSnapshot fires every 300 s"
  }
