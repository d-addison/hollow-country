+def treated_groups(data):
+    root = ET.fromstring(data)
+    return {g.get("name"): g for g in root.iter("group")}
+
+
+def strip_groups(text, names):
+    for name in names:
+        text = re.sub(r'[ \t]*<group name="%s"[^>]*>.*?</group>\r?\n?' % name, "", text, flags=re.S)
+    return text
