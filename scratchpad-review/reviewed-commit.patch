+            hitY = m_HCProbeHitPos[1];
+            dirY = m_HCProbeHitDir[1];
+            startY = hitY - 0.05;
+            if (result == 2)
+            {
+                m_HCProbeStatOther = m_HCProbeStatOther + 1;
+                continue;
+            }
+            if (lastY - hitY < 0.25)
+            {
+                lastY = hitY;
+                continue;
+            }
+            lastY = hitY;
+            surfacePos = m_HCProbeHitPos;
