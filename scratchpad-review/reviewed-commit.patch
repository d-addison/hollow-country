+        float dirZ = 0.0;
+        float dirLength = 0.0;
+        float unitX = 0.0;
+        float unitZ = 0.0;
+        for (door = 0; door < doorCount; door++)
+        {
+            doorPos = m_HCProbeBuilding.CoordToLocal(m_HCProbeBuilding.GetDoorSoundPos(door));
+            if (door > 0)
+                doorText = doorText + ",";
+            doorText = doorText + HCProbeVector(doorPos);
