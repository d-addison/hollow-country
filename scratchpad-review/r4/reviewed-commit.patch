+def native_building(yaw=0.0):
+    building = SampBuilding("Land_Tenement_Big", (3000.0, 20.0, 5000.0), yaw=yaw, clip=NATIVE_BOX)
+    building.doors = [building.to_world((-4.9, -6.35, -0.5))]
+    return building
