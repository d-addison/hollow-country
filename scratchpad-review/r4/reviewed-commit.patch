+        got = keyed(candidates_of(four_placements("Land_Tenement_Small", hits=hits))["candidates"])
+        self.assertEqual({(-4.5, -3.5, 0), (-4.5, -3.5, 1), (-4.5, -3.5, 2)}, set(got))
