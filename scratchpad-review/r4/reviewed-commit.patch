+
+    void HCProbeStep()
+    {
+        if (m_HCProbeCursor >= m_HCProbeClasses.Count())
+        {
+            HCProbeFinish();
+            return;
+        }
+        GetGame().GetCallQueue(CALL_CATEGORY_SYSTEM).CallLater(HCProbeStep, 100, false);
+        int phase = m_HCProbePhase;
+        if (phase == 0)
+        {
+            HCProbeBeginBuilding();
+            return;
+        }
+        if (phase == 1)
+        {
+            HCProbeScanRow();
+            return;
+        }
+        HCProbeEndBuilding();
+    }
