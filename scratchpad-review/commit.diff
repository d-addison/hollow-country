+LIGHTS = ["Flashlight", "TLRLight", "UniversalLight"]
+FITS = {"UniversalLight": {"helmetFlashlight", "weaponFlashlight"}, "TLRLight": {"pistolFlashlight"}, "Flashlight": set()}
