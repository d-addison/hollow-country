+def text_field(path, value):
+    return {"ConfigPath": path, "ReadAs": "text", "ExpectedReadAs": "text", "ConfigTypeName": "CT_STRING",
+            "Status": "captured", "ValueCaptured": 1, "UnresolvedReasons": [], "ValueText": value}
