+        in_strings = '        row = "+++++++++++++ + + + + + + + + + + + +";'
+        self.assertEqual([], self.issues(in_strings))
+        compound = "        int n = 0;\n        n++;\n        n += 1;\n        n++; n++; n++; n++; n++; n++; n++; n++; n++; n++; n++;"
