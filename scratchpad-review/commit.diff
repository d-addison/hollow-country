+
+BATTLEYE_SHA256 = rt.BATTLEYE_SHA256
+DEFAULT_SOURCE_RUNTIME = rt.DEFAULT_SOURCE_RUNTIME
+WSL_PARENT = Path("/mnt/d/HollowCountryLocal")
+PLAN_NAME = "weather-probe-plan.json"
