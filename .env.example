# All paths and names are placeholders. Fill only on local machines; do not commit .env.
DAYZ_CLIENT_ROOT=C:\\Steam\\steamapps\\common\\DayZ
DAYZ_TOOLS_ROOT=C:\\Steam\\steamapps\\common\\DayZ Tools
DAYZ_SERVER_ROOT=D:\\DayZServer
DAYZ_PROJECT_DRIVE=P:\\
# Loopback for local testing. Put a remote server's real address only in your local .env
# (documentation example: 192.0.2.10, RFC 5737).
DAYZ_SERVER_HOST=127.0.0.1
DAYZ_SERVER_PORT=2302
DAYZ_MISSION=dayzOffline.chernarusplus
DAYZ_PROFILE_DIR=D:\\DayZServer\\profiles
